#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for signalk-server-docker development.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

readonly IMAGE_NAME="signalk-server-halos"

# shellcheck source=build.env
source ./build.env
# Exported: tests/verify-image.sh gates its base-image comparisons on BASE, and a
# sourced assignment does not reach a child process -- both would silently SKIP.
export BASE

# The version half of our tag comes from the base image's own installed
# signalk-server, not from parsing BASE. Whatever upstream calls its tags is
# upstream's business; what is actually installed is the fact we publish.
function upstream_version {
  docker run --rm --entrypoint node "${BASE}" \
    -p "require('/home/node/signalk/node_modules/signalk-server/package.json').version"
}

################################################################################
# Image Commands

function version {
  #@ Print the tag the current build.env would publish
  #@ Category: Image
  # `-halos.` is what a consumer splits on to tell upstream's version from our
  # build revision. Both halves are checked before they reach a tag name: an
  # unreadable base image or a non-numeric BUILD would otherwise compose a
  # string Docker accepts, and a published tag is never reused.
  local upstream
  upstream="$(upstream_version)"
  if [[ ! "${upstream}" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
    echo "ERROR: no version read from ${BASE} (got '${upstream}')" >&2
    return 1
  fi
  if [[ ! "${BUILD}" =~ ^[0-9]+$ ]]; then
    echo "ERROR: BUILD in build.env must be a whole number (got '${BUILD}')" >&2
    return 1
  fi
  echo "v${upstream}-halos.${BUILD}"
}

function build {
  #@ Build the image locally for this machine's architecture
  #@ Category: Image
  local tag
  tag="${IMAGE_NAME}:$(version)"
  docker build --build-arg "BASE=${BASE}" --build-arg "BUILD=${BUILD}" -t "${tag}" "$@" .
  echo "Built ${tag}"
}

function verify {
  #@ Assert the built image loads every curated package
  #@ Category: Image
  local image="${1:-${IMAGE_NAME}:$(version)}"
  tests/verify-image.sh "${image}" plugins.list
}

function shell {
  #@ Open a shell inside the built image
  #@ Category: Image
  docker run --rm -it --entrypoint bash "${IMAGE_NAME}:$(version)"
}

function plugin-versions {
  #@ Report the plugin versions resolved into an image
  #@ Category: Image
  local image="${1:-${IMAGE_NAME}:$(version)}"
  # Nothing is pinned, matching upstream -- so what a published tag actually
  # contains is answered by asking the image, not by reading a lockfile.
  # Enumerated from the image rather than from the manifest, so anything that
  # arrived as a dependency shows up in the record too.
  docker run --rm --entrypoint node "${image}" -e '
    const fs = require("fs");
    const root = "/home/node/signalk/node_modules/signalk-server/node_modules/";
    const names = [];
    for (const e of fs.readdirSync(root)) {
      if (e.startsWith("@")) for (const s of fs.readdirSync(root + e)) names.push(e + "/" + s);
      else names.push(e);
    }
    for (const p of names.sort()) {
      try { console.log(p + "@" + require(root + p + "/package.json").version); } catch {}
    }'
}

################################################################################
# Maintenance Commands

function install-hooks {
  #@ Install lefthook pre-commit hooks
  #@ Category: Maintenance
  lefthook install
}

################################################################################
# Core Commands

function help {
  #@ Show this help message
  #@ Category: Core
  echo "HaLOS Signal K Server Image - Development Commands"
  echo "=================================================="
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
