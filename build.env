# The only file an upstream bump touches.
#
# BASE is the upstream image reference, verbatim -- never parsed or reassembled.
# The published tag's version half is read from the image itself at build time,
# so this string's shape is upstream's business, not ours.
#
# BUILD is our revision of that base. Reset it to 1 when BASE changes;
# increment it for a plugin-set change or a rebuild.
BASE=signalk/signalk-server:v2.32.0-core
BUILD=1
